+@pytest.fixture(autouse=True)
+def _isolated(monkeypatch):
+    for name in ENV_NAMES:
+        monkeypatch.delenv(name, raising=False)
+    reset_model_registry_for_tests()
+    reset_model_health_for_tests()
+    ps.reset_for_tests()
+    yield
+    reset_model_registry_for_tests()
+    reset_model_health_for_tests()
+    ps.reset_for_tests()
