+ENV_NAMES = (
+    "XAI_API_KEY", "GOOGLE_AI_API_KEY", "GEMMA_TRANSPORT", "GEMMA_LOCAL_BASE_URL",
+    "GROK_MODEL_ID", "GEMMA_MODEL_ID", "CUSTOM_AI_BASE_URL", "CUSTOM_AI_MODEL_ID",
