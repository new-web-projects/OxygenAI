+@pytest.mark.parametrize(
+    "status,message,model,expected",
+    [
+        (404, "Grok API error 404: The model grok-9 does not exist", "grok-9", True),
+        (404, "Grok API error 404: Not Found", "grok-9", False),            # wrong URL, not a missing model
