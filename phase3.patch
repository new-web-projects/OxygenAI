+        ss.encrypt_secret("x" * 10)
+    monkeypatch.setenv("SETTINGS_ENCRYPTION_KEY", ss.generate_key())
+    with pytest.raises(ss.SecretStoreError, match="empty"):
+        ss.encrypt_secret("")
