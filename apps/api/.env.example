# CORS: the Next.js frontend's origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional. Without this, the app runs on ephemeral synthetic data --
# nothing persists, but it still works.
DATABASE_URL=

# Required for login. Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real value.
JWT_SECRET=

JWT_ISSUER=oxygen-ai
ACCESS_TOKEN_TTL_SECONDS=3600

# Passage 4 §6.2: /api/ai/analyze requires a JWT. Leave true (the default)
# for anything but local development; false re-enables anonymous access and
# the API logs a warning at startup. Create the first admin with:
#   python -m app.cli create-admin --email you@example.com
AUTH_REQUIRED=true

# Number of reverse proxies in front of the API that append to
# X-Forwarded-For (0 = ignore the header, use the socket address).
# Rate limits and session IPs are keyed off this — see app/security/network.py.
# Behind a proxy, set this (and start uvicorn with --no-proxy-headers so this
# setting is the single authority); if you leave it 0 behind a proxy that does
# not preserve the client address, every client shares one rate-limit bucket.
TRUSTED_PROXY_COUNT=0

# Optional per-minute overrides (defaults shown).
# RATE_LIMIT_ANALYZE=30
# RATE_LIMIT_AUTH=10

# Optional. Without these, the app falls back to the offline Mock
# provider for that provider id -- nothing breaks if you leave them blank.

# Gemma 4 -- hosted via Google's Gemini API transport (get a free key at
# https://aistudio.google.com/apikey). Deliberately not named GEMINI_*:
# Gemini is the transport, Gemma 4 is the provider.
GOOGLE_AI_API_KEY=
GEMMA_MODEL_ID=

# Grok -- from https://console.x.ai
XAI_API_KEY=
GROK_MODEL_ID=

# Custom AI ("Oxygen AI" in the UI) -- any OpenAI-compatible
# chat-completions endpoint. All three must be set together.
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL_ID=
CUSTOM_AI_SOURCE_TAG=
