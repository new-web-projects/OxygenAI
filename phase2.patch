+async def _drop_instrument(pool, symbol: str) -> None:
+    for table in ("trading_signals", "technical_indicators", "market_data"):
+        await pool.execute(
+            f"DELETE FROM {table} WHERE instrument_id IN (SELECT id FROM market_instruments WHERE symbol = $1)",
+            symbol,
+        )
