# Optional. Without these, the app falls back to the offline Mock provider
# for that provider id — nothing breaks if you leave them blank.

# Gemma 4 — hosted via Google's Gemini API transport (get a free key at
# https://aistudio.google.com/apikey). Deliberately not named GEMINI_*:
# Gemini is the transport, Gemma 4 is the provider — see gemmaProvider.ts.
GOOGLE_AI_API_KEY=
# Verify against https://ai.google.dev/gemma/docs/core/model_card_4 before
# relying on the default — Gemma 4 model ID strings have shifted between
# release waves.
GEMMA_MODEL_ID=

# Grok — from https://console.x.ai
XAI_API_KEY=
GROK_MODEL_ID=

# Custom AI — any OpenAI-compatible chat-completions endpoint: OpenAI
# itself, a self-hosted Ollama/vLLM server, a router like OpenRouter, etc.
# All three must be set together for this provider to activate.
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL_ID=
# Set to "local_model" if CUSTOM_AI_BASE_URL points at something you're
# self-hosting, so responses get tagged correctly. Defaults to hosted_api.
CUSTOM_AI_SOURCE_TAG=
