+    # The upload always "succeeded" — it was the SEARCH that failed afterwards.
+    uploaded = await _upload(client, admin, bengali_title, BENGALI_TEXT)
+    assert uploaded.status_code == 200 and uploaded.json()["chunkCount"] >= 1
